# ── EIA API — feeds the ingestion pipeline (Henry Hub natgas, storage, urea).
EIA_API_KEY=your_eia_api_key_here

# ── Data source (Postgres / dbt mart)
# docker-compose brings up a postgres service with these credentials; inside
# the compose network the host is `postgres`, otherwise `localhost`.
DATABASE_URL=postgresql+psycopg2://postgres:devpass@localhost:5432/foregast
# train_models.py reads this: "mart" (dbt mart via DATABASE_URL, the default)
# or "pipeline" (legacy in-process ingestion). Silently falls back mart→pipeline
# if DATABASE_URL is unset.
FEATURE_SOURCE=mart
# Override the mart table name only if you renamed the dbt model.
MART_TABLE=dev_marts.mart_commodity_panel_monthly

# ── dbt (used directly, outside docker-compose — e.g. `dbt run` from foregast_dbt/)
# Defaults already match the docker-compose postgres service; only needed if running dbt standalone.
POSTGRES_HOST=localhost
POSTGRES_PASSWORD=devpass

# ── API cache — where the FastAPI service reads the pre-computed forecast bundle from.
# Leave blank to use the repo default (<repo>/data/processed/cache.json).
# The container image sets this to /app/data/processed/cache.json.
CACHE_PATH=

# ── Experiment tracking (Weights & Biases)
# Optional — leave blank to run wandb in offline mode (docker-compose already
# sets WANDB_MODE=offline). Set a real key to sync training runs to app.wandb.ai.
WANDB_API_KEY=your_wandb_api_key_here
