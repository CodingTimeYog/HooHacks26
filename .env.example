# EIA API
EIA_API_KEY=your_eia_api_key_here

# Postgres / dbt mart. docker-compose provides a postgres service with these
# credentials (inside the compose network the host is overridden to `postgres`).
# With DATABASE_URL set, features are read from the dbt mart (FEATURE_SOURCE=mart,
# the default); unset it to fall back to the legacy pandas pipeline.
DATABASE_URL=postgresql+psycopg2://postgres:devpass@localhost:5432/foregast

# Email Configuration (optional - only needed when you're ready to send real emails)
# For testing/development, leave these blank or use EMAIL_TEST_MODE=true
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password
DASHBOARD_URL=http://localhost:8501
API_BASE_URL=http://localhost:8000
EMAIL_TEST_MODE=true
